# 复制本文件为 .env 后填写真实值：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入版本库。
# Expo 打包时会把 EXPO_PUBLIC_* 前缀的变量内联进产物。

# 反馈接口地址
EXPO_PUBLIC_FEEDBACK_API_URL=https://payrecord-feedback.vercel.app/api/feedback

# 反馈接口密钥：必须与 payrecord-feedback（Vercel 项目）里的 API_KEY 环境变量一致
EXPO_PUBLIC_FEEDBACK_API_KEY=
